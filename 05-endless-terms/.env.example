# .env 로 복사해서 쓰세요. 비워두면 랭킹을 메모리에 저장합니다 (서버 끄면 사라짐).
# 공개 배포 시 Upstash Redis를 꼭 연결하세요. 01-nyam-nyam과 같은 DB를 써도 됩니다 (키 이름이 terms: 로 시작해서 안 겹침).
# Vercel Storage로 연결해서 KV_REST_API_URL / KV_REST_API_TOKEN 이름으로 들어와도 그대로 읽습니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 랭킹 등록 횟수 제한 (IP당 1분에 몇 번)
TERMS_RATE_PER_MIN=5
